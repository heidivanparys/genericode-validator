<?xml version="1.0" encoding="UTF-8"?>
<gc:CodeList
    xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <Identification>
        <ShortName>shortnameø</ShortName>
        <Version>1,0,0</Version>
        <CanonicalUri>urn:uuid:id-1</CanonicalUri>
        <CanonicalVersionUri>urn:uuid:id-2</CanonicalVersionUri>
        <LocationUri>https://</LocationUri>
        <AlternateFormatLocationUri MimeType="text/csv"></AlternateFormatLocationUri>
        <AlternateFormatLocationUri MimeType="text/html"></AlternateFormatLocationUri>
        <Agency>
            <LongName>Agency</LongName>
        </Agency>
    </Identification>
    <ColumnSet>
        <Column
            Id="code"
            Use="required">
            <ShortName>kode </ShortName>
            <Data Type="string" />
        </Column>
        <Column
            Id="name"
            Use="required">
            <ShortName>navn </ShortName>
            <Data
                Type="string"
                Lang="en" />
        </Column>
    </ColumnSet>
    <SimpleCodeList />
</gc:CodeList>